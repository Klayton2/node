<%- include('../partials/header') %>
    <header>
        <h1>Agenda de Contatos</h1>
        <h4>Bem vindo !</h4>
    </header>
    <section>
        <form action="/entrar" method="post">
            <input type="email" name="usuario[email]" id="email" placeholder="Email">
            <br>
            <input type="password" name="usuario[password]" id="password" placeholder="Senha">
            <br>
            <button type="submit">Entrar</button>
        </form>
        <table>
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Email</th>
                    <th>Ação</th>
                </tr>
            </thead>
            <tbody>
                <% contatos.forEach((contato,index)=>{ %>
                    <tr><%- contato.nome %>></td>
                        <td><%- contato.email %></td>
                        <td><a href="/contato/<%- index %>"></a>Detalhes</td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </section>
</body>
<%- include('../partials/sair') %>
</html>