<%- include ('../header');%>
<header>
    <h1>Agenda de Contatos</h1>
</header>
<section>
    <p>Bem vino <%-usuario.nome %></p>
</section>
<% contatos.forEarch((contato, index) =>{
    <tr>
        <td><%- contato.nome %></td>
        <td><%- contato.email %></td>
        <td>
            <a href="/contatos/<%- index %>">Detalhes</a>
            <a href="/chat">Conversar</a>
        </td>
    </tr>
<%}) %>
<%- include ('../partial/sair'); %>